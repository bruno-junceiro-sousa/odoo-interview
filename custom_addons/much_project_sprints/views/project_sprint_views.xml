<odoo>
    <record id="view_project_sprint_form" model="ir.ui.view">
        <field name="name">project.sprint.form</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start Sprint" type="object"
                            class="btn-primary" invisible="state != 'open'"
                            groups="project.group_project_manager"/>
                    <button name="action_close" string="Close Sprint" type="object"
                            class="btn-primary" invisible="state != 'active'"
                            confirm="Unfinished tasks will be moved to the next open sprint (or the backlog). Continue?"
                            groups="project.group_project_manager"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="state != 'closed'"
                            groups="project.group_project_manager"/>
                    <button name="action_open_add_tasks_wizard" string="Add Tasks from Backlog"
                            type="object" class="btn-secondary"
                            invisible="state != 'open'"
                            groups="project.group_project_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id" readonly="state != 'open'"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="state == 'closed'"/>
                            <field name="date_end" readonly="state == 'closed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tasks">
                            <field name="task_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_project_sprint_list" model="ir.ui.view">
        <field name="name">project.sprint.list</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
                <field name="task_count"/>
            </list>
        </field>
    </record>

    <!-- INFO: Kanban view of all the Sprints grouped by state -->
    <record id="view_project_sprint_kanban" model="ir.ui.view">
        <field name="name">project.sprint.kanban</field>
        <field name="model">project.sprint</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="project_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
                <field name="task_count"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="project_id"/>
                                <div>
                                    <field name="date_start"/> → <field name="date_end"/>
                                </div>
                                <div>
                                    <span class="badge badge-pill">
                                        <field name="task_count"/> tasks
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="state" widget="label_selection"
                                        options="{'classes': {'open': 'default', 'active': 'success', 'closed': 'muted'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_project_sprint" model="ir.actions.act_window">
        <field name="name">Sprints</field>
        <field name="res_model">project.sprint</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_project_sprint"
              name="Sprints"
              parent="project.menu_main_pm"
              action="action_project_sprint"/>
</odoo>