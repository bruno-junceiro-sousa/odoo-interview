<odoo>
    <record id="view_project_sprint_add_tasks_wizard_form" model="ir.ui.view">
        <field name="name">project.sprint.add.tasks.wizard.form</field>
        <field name="model">project.sprint.add.tasks.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Tasks from Backlog">
                <field name="sprint_id" invisible="1"/>
                <field name="project_id" invisible="1"/>
                <group>
                    <field name="task_ids"/>
                </group>
                <footer>
                    <button string="Add to Sprint" type="object"
                            name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>